  "main": "bilingual_localization.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "ci:install": "pnpm install --frozen-lockfile && pnpm add -w typescript tsx ynpx @yarn-tool/changelog",
    "ci:build": "pnpm run postpublish:changelog && pnpm run postpublish",
    "postpublish": "pnpm run postpublish:git:commit && pnpm run postpublish:git:tag && pnpm run postpublish:git:push",
    "postpublish:changelog": "ynpx --quiet @yarn-tool/changelog && git add ./CHANGELOG.md & echo postpublish:changelog",
    "postpublish:git:commit": "git commit -m \"chore(release): publish\" & echo postpublish:git:commit",
    "postpublish:git:push": "git push --follow-tags",
    "postpublish:git:tag": "ynpx --quiet @yarn-tool/tag -- -f"
  }
}
